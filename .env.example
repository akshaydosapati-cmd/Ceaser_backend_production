PYTHON_VERSION=3.12.8
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@[HOST]:5432/postgres
JWT_SECRET=
ENCRYPTION_MASTER_KEY=
